# Copy to .env.local. Never commit real values.

# FastAPI backend base URL (defaults to http://127.0.0.1:8000 when unset).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Google OAuth web client ID for read-only Calendar import. This is a public
# identifier, not a secret. When unset, the Calendar button explains how to add it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
